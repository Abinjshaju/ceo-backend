# Database: PostgreSQL with pgvector (see compose.yaml). SQLite works for quick local runs.
DATABASE_URL=postgresql+psycopg://ceo:ceo@127.0.0.1:55432/ceo

# Gemini
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDINGS_ENABLED=true
RESEARCH_ENABLED=true
OCR_ENABLED=true
# Spoken replies. When off (or without a key) the browser reads replies with its own voice.
SPEECH_ENABLED=true
SPEECH_MODEL=gemini-3.8-flash-lite-tts
SPEECH_VOICE=Kore
# Voice conversation: what the user says is transcribed by Gemini.
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL=gemini-3.6-flash

# Auth.
#   local (default): email/password accounts kept by this server; it signs its own tokens with AUTH_JWT_SECRET.
#   jwks: tokens from an OIDC provider (set AUTH_JWKS_URL, AUTH_ISSUER, AUTH_AUDIENCE), for example
#         Clerk https://<domain>/.well-known/jwks.json or Auth0 https://<tenant>.auth0.com/.well-known/jwks.json
#   hs256: tokens signed elsewhere with the shared AUTH_JWT_SECRET.
# `uv run ceo-backend dev-token --email you@example.com` issues a token in local or hs256 mode.
AUTH_MODE=local
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_HOURS=168
AUTH_ISSUER=
AUTH_AUDIENCE=

# Browser origins allowed to call the API (comma separated). Not needed when the API serves the frontend.
CORS_ORIGINS=

# Document storage. "local" serves HMAC-signed URLs from this API; "s3" uses presigned URLs.
STORAGE_BACKEND=local
STORAGE_DIR=./storage
STORAGE_SIGNING_SECRET=change-me-to-another-long-random-string
# Leave empty when the browser reaches the API on the same origin (the default setup).
PUBLIC_BASE_URL=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
MAX_UPLOAD_BYTES=26214400

# Run background jobs inside the API process (development). In production set false and run `ceo-backend worker`.
JOBS_INLINE=true
